# TRAP//RUN (Trap Run Dungeon) Environment Configuration Example

# NEAR Protocol Configuration
# Network must be 'testnet' for this phase
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://rpc.testnet.fastnear.com

# Canonical account where trap_run_registry.wasm is deployed on NEAR Testnet
# Example: traprun-registry.testnet
# (Note: VITE_NEAR_REGISTRY_CONTRACT is supported as an alias)
VITE_NEAR_REGISTRY_ACCOUNT=traprun-registry.testnet

# Publishing storage deposit in yoctoNEAR (default: 0.05 NEAR = 5 * 10^22 yoctoNEAR)
VITE_NEAR_STORAGE_DEPOSIT_YOCTO=50000000000000000000000

# Supabase Backend Configuration (Shared cross-device catalog & authoritative stats)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
