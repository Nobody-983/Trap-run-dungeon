# TRAP//RUN Environment Configuration Example

# NEAR Protocol Configuration
# Network must be 'testnet' for this phase
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://rpc.testnet.near.org
# Account where trap_run_registry.wasm is deployed on NEAR Testnet
VITE_NEAR_REGISTRY_ACCOUNT=
# Conservative storage deposit buffer in yoctoNEAR (default: 0.01 NEAR = 10^22 yoctoNEAR)
VITE_NEAR_STORAGE_DEPOSIT_YOCTO=10000000000000000000000

# Supabase Public Configuration (Accessible in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Secret (NEVER expose to frontend; used in server verification API)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
