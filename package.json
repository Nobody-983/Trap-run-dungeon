{
  "name": "trap-run",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint --type-aware src scripts --fix; s=$?; oxlint --fix src scripts; exit $((s>0?s:$?))",
    "typecheck": "tsc --noEmit",
    "check": "bash scripts/check.sh",
    "test": "bun test scripts/run-validator.test.ts && bun run identity:test:ts && bun run near:registry:client-test && bun run verify:levels",
    "validator:test": "bun test scripts/run-validator.test.ts",
    "identity:test:ts": "node --experimental-strip-types scripts/canonical-identity.test.ts",
    "identity:test:rust": "rustc --edition=2021 --test scripts/canonical_identity_compat.rs -o /tmp/traprun-canonical-rust-tests && /tmp/traprun-canonical-rust-tests",
    "near:registry:test": "cargo test --manifest-path near/registry/Cargo.toml --target x86_64-unknown-linux-gnu",
    "near:registry:build": "cargo build --manifest-path near/registry/Cargo.toml --target wasm32-unknown-unknown --release",
    "near:registry:client-test": "node --experimental-strip-types scripts/near-registry-client.test.ts",
    "verify:levels": "bun run ./scripts/verify-levels.ts"
  },
  "dependencies": {
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/my-near-wallet": "10.1.4",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.62.7",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "near-api-js": "^7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
